<mvc:View
	controllerName="zgpms.meilpower.com.controller.InwardInsuranceList"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page
		title="Inward Insurance List"
		showNavButton="true"
		navButtonPress=".onNavBack"
		class="gpmsPage">
		<content>
			<VBox class="sapUiSmallMargin">
				<Table
					id="inwardInsuranceTable"
					items="{inwardInsuranceList>/results}"
					noDataText="No Inward Insurance records found"
					class="gpmsTable"
					alternateRowColors="true">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Inward Insurance Records" level="H2"/>
							<ToolbarSpacer/>
							<SearchField
								width="300px"
								search=".onSearch"
								placeholder="Search Invoice No or Vendor..."
								class="gpmsFieldInput"/>
							<DatePicker id="idExcelFromDate" placeholder="From Date" displayFormat="dd-MM-yyyy" width="150px" change=".onDateFilterChange"/>
							<DatePicker id="idExcelToDate" placeholder="To Date" displayFormat="dd-MM-yyyy" width="150px" change=".onDateFilterChange"/>
							<Button icon="sap-icon://download" text="Download Excel" press=".onDownloadExcel" tooltip="Export to Excel"/>
							<Button icon="sap-icon://sort" tooltip="Sort" press=".onSort" type="Transparent"/>
							<Button id="idInsCopyListBtn" icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard"/>
							<Button id="idInsPrintListBtn" icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print list"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column><Button text="Invoice Number" icon="{= ${sortModel>/InvoiceNumber} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/InvoiceNumber} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="InvoiceNumber"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
						<Column><Button text="Insurance Date" icon="{= ${sortModel>/InsuranceDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/InsuranceDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="InsuranceDate"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
						<Column><Button text="Received Date" icon="{= ${sortModel>/RecievedDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/RecievedDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="RecievedDate"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
						<Column><Button text="Vendor Name" icon="{= ${sortModel>/VendorName} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/VendorName} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="VendorName"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
						<Column><Button text="Mode of Transport" icon="{= ${sortModel>/ModeOfTransport} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/ModeOfTransport} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="ModeOfTransport"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
						<Column><Button text="LR Number" icon="{= ${sortModel>/LRNumber} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/LRNumber} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="LRNumber"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
						<Column><Button text="Vehicle No" icon="{= ${sortModel>/VehicleNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/VehicleNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="VehicleNo"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
						<Column hAlign="Right"><Button text="Invoice Value" icon="{= ${sortModel>/InvoiceValue} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/InvoiceValue} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="InvoiceValue"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
						<Column><Button text="Description" icon="{= ${sortModel>/RGPCoomonDesc} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/RGPCoomonDesc} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="RGPCoomonDesc"/><core:CustomData key="tableName" value="idInwardInsuranceTable"/></customData></Button></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRowPress" class="gpmsTableRow">
							<cells>
								<Text text="{inwardInsuranceList>InvoiceNumber}" class="gpmsTableText"/>
								<Text text="{path: 'inwardInsuranceList>InsuranceDate', formatter: '.formatDate'}" class="gpmsTableText"/>
								<Text text="{path: 'inwardInsuranceList>RecievedDate', formatter: '.formatDate'}" class="gpmsTableText"/>
								<Text text="{inwardInsuranceList>VendorName}" class="gpmsTableText"/>
								<Text text="{inwardInsuranceList>ModeOfTransport}" class="gpmsTableText"/>
								<Text text="{inwardInsuranceList>LRNumber}" class="gpmsTableText"/>
								<Text text="{inwardInsuranceList>VehicleNo}" class="gpmsTableText"/>
								<Text text="{path: 'inwardInsuranceList>InvoiceValue', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}" class="gpmsTableText" textAlign="Right"/>
								<Text text="{inwardInsuranceList>RGPCoomonDesc}" class="gpmsTableText"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>
