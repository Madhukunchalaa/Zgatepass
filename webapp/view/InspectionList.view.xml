<mvc:View
    controllerName="zgpms.meilpower.com.controller.InspectionList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    height="100%">

    <Page title="Gate Entry List" class="gpmsPage" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiSmallMargin">
                <Table id="idInspectionTable"
                    items="{inspList>/results}"
                    class="gpmsTable"
                    noDataText="No Gate Entries Found"
                    alternateRowColors="true">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Gate Entry List" level="H2"/>
                            <ToolbarSpacer />
                            <SearchField width="300px" search=".onSearch" placeholder="Search..." class="gpmsFieldInput"/>
                            <Button icon="sap-icon://sort" tooltip="Sort" press=".onSort" type="Transparent"/>
                            <Button icon="sap-icon://filter" tooltip="Filter" press=".onFilter" type="Transparent"/>
                            <Select id="idInspectionStatusFilter" change=".onApplyFilters" selectedKey="Pending" width="150px" class="gpmsFieldInput">
                                <items>
                                    <core:Item key="" text="All Statuses"/>
                                    <core:Item key="Open" text="Open"/>
                                    <core:Item key="Pending" text="Pending"/>
                                    <core:Item key="Completed" text="Completed"/>
                                </items>
                            </Select>
                            <DatePicker id="idExcelFromDate" placeholder="From Date" displayFormat="dd-MM-yyyy" width="150px" class="gpmsFieldInput"/>
                            <DatePicker id="idExcelToDate" placeholder="To Date" displayFormat="dd-MM-yyyy" width="150px" class="gpmsFieldInput"/>
                            <Button text="Apply" type="Emphasized" press=".onApplyFilters"/>
                            <Button text="Clear" press=".onClearFilters"/>
                            <Button icon="sap-icon://download" text="Download Excel" press=".onDownloadExcel" tooltip="Export to Excel" class="sapUiTinyMarginEnd"/>
                            <Button icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard" class="sapUiTinyMarginEnd"/>
                            <Button icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print list"/>
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column><Button text="GE Date" icon="{= ${sortModel>/GEDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GEDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GEDate"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="GE No" icon="{= ${sortModel>/GateEntryNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GateEntryNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GateEntryNo"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="Supplier" icon="{= ${sortModel>/VendorDesc} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/VendorDesc} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="VendorDesc"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="Source Type" icon="{= ${sortModel>/SourceType} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/SourceType} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="SourceType"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="Dept" icon="{= ${sortModel>/Department} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/Department} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="Department"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="RGP No" icon="{= ${sortModel>/RGPNumber} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/RGPNumber} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="RGPNumber"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="Inv No" icon="{= ${sortModel>/DCNumber} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/DCNumber} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="DCNumber"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="RR No" icon="{= ${sortModel>/RRNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/RRNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="RRNo"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="Gate Pass No" icon="{= ${sortModel>/GatepassNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatepassNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatepassNo"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column><Button text="Inspection Status" icon="{= ${sortModel>/InspectionStatus} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/InspectionStatus} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="InspectionStatus"/><core:CustomData key="tableName" value="idInspectionTable"/></customData></Button></Column>
                        <Column hAlign="Center"><Text text="Action" class="gpmsTableHeaderText"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem class="gpmsTableRow">
                            <cells>
                                <Text text="{inspList>GEDate}" class="gpmsTableText"/>
                                <Text text="{inspList>GateEntryNo}" class="gpmsTableText"/>
                                <Text text="{inspList>VendorDesc}" class="gpmsTableText"/>
                                <Text text="{inspList>SourceType}" class="gpmsTableText"/>
                                <Text text="{inspList>Department}" class="gpmsTableText"/>
                                <Text text="{inspList>RGPNumber}" class="gpmsTableText"/>
                                <Text text="{inspList>DCNumber}" class="gpmsTableText"/>
                                <Text text="{inspList>RRNo}" class="gpmsTableText"/>
                                <Text text="{inspList>GatepassNo}" class="gpmsTableText"/>
                                <Text text="{inspList>InspectionStatus}" class="gpmsTableText"/>
                                <HBox justifyContent="Center" class="gpmsActionBox">
                                    <Button icon="sap-icon://show" type="Default" tooltip="View" press=".onViewEntry" class="sapUiTinyMarginEnd gpmsActionButton"/>
                                    <Button icon="sap-icon://edit" type="Default" tooltip="Edit" press=".onEditEntry" class="sapUiTinyMarginEnd gpmsActionButton"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
            </VBox>
        </content>
    </Page>

</mvc:View>
