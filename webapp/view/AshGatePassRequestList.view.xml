<mvc:View
	controllerName="zgpms.meilpower.com.controller.AshGatePassRequestList"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page
		title="Ash Gate Pass Request List"
		showNavButton="true"
		navButtonPress=".onNavBack"
		class="gpmsPage">
		<content>
			<VBox class="sapUiSmallMargin">
				<Table
					id="ashReqListTable"
					items="{ashReqList>/results}"
					noDataText="No Ash Gate Pass Requests found"
					class="gpmsTable"
					alternateRowColors="true">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Ash Gate Pass Requests" level="H2"/>
							<ToolbarSpacer/>
							<SearchField width="300px" search=".onSearch" placeholder="Search Request No / Customer..." class="gpmsFieldInput"/>
							<Select id="idAshStatusFilter" change=".onApplyFilters" width="150px" class="gpmsFieldInput">
								<items>
									<core:Item key="" text="All Statuses"/>
									<core:Item key="A1" text="Approved"/>
									<core:Item key="R" text="Rejected"/>
									<core:Item key="P" text="Pending"/>
								</items>
							</Select>
							<DatePicker id="idExcelFromDate" placeholder="From Date" displayFormat="dd-MMM-yyyy" width="150px" class="gpmsFieldInput"/>
							<DatePicker id="idExcelToDate" placeholder="To Date" displayFormat="dd-MMM-yyyy" width="150px" class="gpmsFieldInput"/>
							<Button text="Apply" type="Emphasized" press=".onApplyFilters"/>
							<Button text="Clear" press=".onClearFilters"/>
							<Button icon="sap-icon://download" text="Download Excel" press=".onDownloadExcel" tooltip="Export to Excel" class="sapUiTinyMarginEnd"/>
							<Button icon="sap-icon://sort" tooltip="Sort" press=".onSort" type="Transparent" class="sapUiTinyMarginEnd"/>
							<Button icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard" class="sapUiTinyMarginEnd"/>
							<Button icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print list"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column><Button text="Request No" icon="{= ${sortModel>/GatePassReqNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatePassReqNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatePassReqNo"/><core:CustomData key="tableName" value="ashReqListTable"/></customData></Button></Column>
						<Column><Button text="Gate Pass No" icon="{= ${sortModel>/GatePassNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatePassNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatePassNo"/><core:CustomData key="tableName" value="ashReqListTable"/></customData></Button></Column>
						<Column><Button text="Sales Document" icon="{= ${sortModel>/SalesDocument} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/SalesDocument} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="SalesDocument"/><core:CustomData key="tableName" value="ashReqListTable"/></customData></Button></Column>
						<Column><Button text="Customer Name" icon="{= ${sortModel>/CustomerName} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/CustomerName} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="CustomerName"/><core:CustomData key="tableName" value="ashReqListTable"/></customData></Button></Column>
						<Column><Button text="Vehicle No" icon="{= ${sortModel>/VehicleNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/VehicleNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="VehicleNo"/><core:CustomData key="tableName" value="ashReqListTable"/></customData></Button></Column>
						<Column><Button text="GP Date" icon="{= ${sortModel>/GPDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GPDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GPDate"/><core:CustomData key="tableName" value="ashReqListTable"/></customData></Button></Column>
						<Column><Button text="Approval" icon="{= ${sortModel>/Status} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/Status} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="Status"/><core:CustomData key="tableName" value="ashReqListTable"/></customData></Button></Column>
						<Column hAlign="Center" width="4rem"><Text text="Action" class="gpmsTableHeaderText"/></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRowPress" class="gpmsTableRow">
							<cells>
								<Text text="{ashReqList>GatePassReqNo}" class="gpmsTableText"/>
								<Text text="{ashReqList>GatePassNo}" class="gpmsTableText"/>
								<Text text="{ashReqList>SalesDocument}" class="gpmsTableText"/>
								<Text text="{ashReqList>CustomerName}" class="gpmsTableText"/>
								<Text text="{ashReqList>VehicleNo}" class="gpmsTableText"/>
								<Text text="{path: 'ashReqList>GPDate', formatter: '.formatDate'}" class="gpmsTableText"/>
								<ObjectStatus
									text="{= ${ashReqList>Approval1} === 'A1' ? 'Approved' : ${ashReqList>Approval1} === 'R' ? 'Rejected' : 'Pending' }"
									state="{= ${ashReqList>Approval1} === 'A1' ? 'Success' : ${ashReqList>Approval1} === 'R' ? 'Error' : 'Warning' }"
									icon="{= ${ashReqList>Approval1} === 'A1' ? 'sap-icon://accept' : ${ashReqList>Approval1} === 'R' ? 'sap-icon://cancel' : 'sap-icon://pending' }"/>
								<Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onRowPress" tooltip="Open Details"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>
