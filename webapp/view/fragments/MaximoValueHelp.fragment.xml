<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<TableSelectDialog
		id="maximoValueHelpDialog"
		title="Select Maximo Code"
		noDataText="No Maximo Codes Found"
		search=".onMaximoValueHelpSearch"
		confirm=".onMaterialValueHelpConfirm"
		cancel=".onMaterialValueHelpCancel"
		items="{path: 'materials>/results'}">
		<columns>
			<Column width="30%">
				<header>
					<Text text="Maximo Code" />
				</header>
			</Column>
			<Column width="40%">
				<header>
					<Text text="Material Description" />
				</header>
			</Column>
			<Column width="30%">
				<header>
					<Text text="SAP Item Code" />
				</header>
			</Column>
		</columns>
		<items>
			<ColumnListItem type="Active">
				<cells>
					<Text text="{materials>OldMaterialRef}" />
					<Text text="{materials>MaterialName}" />
					<Text text="{materials>Material}" />
				</cells>
			</ColumnListItem>
		</items>
	</TableSelectDialog>
</core:FragmentDefinition>
