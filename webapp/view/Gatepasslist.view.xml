<mvc:View
    controllerName="zgpms.meilpower.com.controller.GatePassList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core">

    <Page title="Gate Pass Requests">
        <subHeader>
            <Bar>
                <contentLeft>
                    <SearchField id="idGatePassSearchField" width="20rem"
                        placeholder="Search Vendor, GP No, User, Description..."
                        liveChange=".onSearchFieldLiveChange" />
                </contentLeft>
                <contentMiddle>
                    <Select id="idStatusFilterSelect" width="11rem" change=".onSelectFilterChange">
                        <core:Item key="" text="All Status" />
                        <core:Item key="Approved" text="Approved" />
                        <core:Item key="HOD approval pending" text="HOD approval pending" />
                        <core:Item key="Store Approval Pending" text="Store Approval Pending" />
                        <core:Item key="Rejected" text="Rejected" />
                        <core:Item key="Closed" text="Closed" />
                        <core:Item key="Cancelled" text="Cancelled" />
                        <core:Item key="Amendment" text="Amendment" />
                    </Select>
                    <Select id="idTypeFilterSelect" width="10rem" change=".onSelectFilterChange">
                        <core:Item key="" text="All Types" />
                        <core:Item key="NRGP" text="NRGP" />
                        <core:Item key="RGP" text="RGP" />
                        <core:Item key="GP with PO" text="GP with PO" />
                    </Select>

                </contentMiddle>
                <contentRight>
                    <DatePicker id="idExcelFromDate" placeholder="From Date" displayFormat="dd-MM-yyyy" change=".onDateFilterChange" width="9rem"/>
                    <DatePicker id="idExcelToDate" placeholder="To Date" displayFormat="dd-MM-yyyy" change=".onDateFilterChange" width="9rem"/>
                    <Button icon="sap-icon://clear-filter" text="Reset" press=".onResetButtonPress" />
                </contentRight>
            </Bar>
        </subHeader>

        <content>
            <Table id="idItemsGatePassTable"
                items="{gatePassList>/filtered}"
                noDataText="No gate pass records found."
                growing="true"
                alternateRowColors="true"
                sticky="ColumnHeaders,HeaderToolbar">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Gate Pass Request List" level="H3" />
                        <ToolbarSpacer />
                        <Text id="idItemCountText" text="" />
                        <Button id="idGPDownloadExcelBtn" icon="sap-icon://download" text="Download Excel" press=".onDownloadExcelButtonPress" tooltip="Export to Excel" class="sapUiTinyMarginEnd"/>
                        <Button id="idGPCopyListBtn" icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard" class="sapUiTinyMarginEnd"/>
                        <Button id="idGPPrintListBtn" icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print gate pass list"/>
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Button text="Request No." icon="{= ${sortModel>/GatePassReqNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatePassReqNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatePassReqNo"/><core:CustomData key="tableName" value="idItemsGatePassTable"/></customData></Button>
                    </Column>
                    <Column width="6rem">
                        <Button text="Type" icon="{= ${sortModel>/GatePassType} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatePassType} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatePassType"/><core:CustomData key="tableName" value="idItemsGatePassTable"/></customData></Button>
                    </Column>
                    <Column width="8rem">
                        <Button text="Date" icon="{= ${sortModel>/GatePassDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatePassDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatePassDate"/><core:CustomData key="tableName" value="idItemsGatePassTable"/></customData></Button>
                    </Column>
                    <Column width="10rem">
                        <Button text="Status" icon="{= ${sortModel>/Status} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/Status} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="Status"/><core:CustomData key="tableName" value="idItemsGatePassTable"/></customData></Button>
                    </Column>
                    <Column width="6rem">
                        <Button text="Plant" icon="{= ${sortModel>/Plant} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/Plant} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="Plant"/><core:CustomData key="tableName" value="idItemsGatePassTable"/></customData></Button>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Button text="Vendor Name" icon="{= ${sortModel>/VendorName} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/VendorName} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="VendorName"/><core:CustomData key="tableName" value="idItemsGatePassTable"/></customData></Button>
                    </Column>
                    <Column width="12rem" minScreenWidth="Tablet" demandPopin="true">
                        <Button text="Department" icon="{= ${sortModel>/Department} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/Department} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="Department"/><core:CustomData key="tableName" value="idItemsGatePassTable"/></customData></Button>
                    </Column>
                    <Column width="10rem" minScreenWidth="Tablet" demandPopin="true">
                        <Button text="Request Person" icon="{= ${sortModel>/Requestor} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/Requestor} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="Requestor"/><core:CustomData key="tableName" value="idItemsGatePassTable"/></customData></Button>
                    </Column>
                    <Column width="8rem" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                        type="{= (${gatePassList>GatePassType} !== 'GP with PO') &amp;&amp; (${user>/IsHodUser} || ${user>/IsStoreUser} || ${gatePassList>Status} === 'Approved' || ${gatePassList>Status} === 'APPROVED' || ${gatePassList>Status} === 'Amendment' || ${gatePassList>Status} === 'AMENDMENT' || ${gatePassList>Status} === 'AM') ? 'Navigation' : 'Inactive'}"
                        press=".onColumnListItemPress">
                        <cells>
                            <ObjectIdentifier
                                title="{gatePassList>GatePassReqNo}"
                                titleActive="{= ${user>/IsStoreUser} || ${gatePassList>Status} === 'Approved' || ${gatePassList>Status} === 'Amendment' || ${gatePassList>Status} === 'AMENDMENT' }"
                                titlePress=".onObjectIdentifierReqNoTitlePress" />
                            <Text text="{gatePassList>GatePassType}" />
                            <Text text="{gatePassList>GatePassDate}" wrapping="false" />
                            <ObjectStatus
                                text="{parts: [{path: 'gatePassList>Status'}, {path: 'gatePassList>Approval1'}, {path: 'gatePassList>Approval2'}, {path: 'gatePassList>ApprovalReq'}, {path: 'gatePassList>STORERemarks'}, {path: 'gatePassList>StoreAmmend'}], formatter: '.formatStatus'}"
                                state="{parts: [{path: 'gatePassList>Status'}, {path: 'gatePassList>Approval1'}, {path: 'gatePassList>Approval2'}, {path: 'gatePassList>ApprovalReq'}, {path: 'gatePassList>STORERemarks'}, {path: 'gatePassList>StoreAmmend'}], formatter: '.formatStatusState'}" />
                            <Text text="{gatePassList>Plant}" />
                            <Text text="{gatePassList>VendorName} " />
                            <Text text="{gatePassList>Department}" />
                            <Text text="{gatePassList>ReqUser}" />
                            <Button
                                text="Approve"
                                icon="sap-icon://approvals"
                                type="Accept"
                                class="approveBtn"
                                visible="{parts: [{path: 'gatePassList>Status'}, {path: 'gatePassList>Approval1'}, {path: 'gatePassList>Approval2'}, {path: 'gatePassList>ApprovalReq'}, {path: 'gatePassList>STORERemarks'}, {path: 'gatePassList>StoreAmmend'}], formatter: '.showApproveBtn'}"
                                press=".onApproveButtonPress" />
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>
    </Page>
</mvc:View>
