<mvc:View
	controllerName="zgpms.meilpower.com.controller.ScrapGatepassList"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page
		title="Scrap Gate Pass List"
		showNavButton="true"
		navButtonPress=".onNavBack"
		class="gpmsPage">
		<content>
			<VBox class="sapUiSmallMargin">
				<Table
					id="scrapGpTable"
					items="{scrapGpList>/}"
					noDataText="No Scrap Gate Passes found"
					class="gpmsTable"
					alternateRowColors="true">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Scrap Gate Passes" level="H2"/>
							<ToolbarSpacer/>
							<SearchField width="300px" search=".onSearch" placeholder="Search Gate Pass No..." class="gpmsFieldInput"/>
							<DatePicker id="idExcelFromDate" placeholder="From Date" displayFormat="dd-MMM-yyyy" width="150px" change=".onDateFilterChange"/>
							<DatePicker id="idExcelToDate" placeholder="To Date" displayFormat="dd-MMM-yyyy" width="150px" change=".onDateFilterChange"/>
							<Button icon="sap-icon://download" text="Download Excel" press=".onDownloadExcel" tooltip="Export to Excel"/>
							<Button icon="sap-icon://sort" tooltip="Sort" press=".onSort" type="Transparent"/>
							<Button id="idScrapGpCopyListBtn" icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard"/>
							<Button id="idScrapGpPrintListBtn" icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print list"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column><Button text="GP No" icon="{= ${sortModel>/gatePassNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/gatePassNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="gatePassNo"/><core:CustomData key="tableName" value="idScrapGpTable"/></customData></Button></Column>
						<Column><Button text="Req No" icon="{= ${sortModel>/requestId} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/requestId} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="requestId"/><core:CustomData key="tableName" value="idScrapGpTable"/></customData></Button></Column>
						<Column><Button text="Date" icon="{= ${sortModel>/requestDateStr} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/requestDateStr} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="requestDateStr"/><core:CustomData key="tableName" value="idScrapGpTable"/></customData></Button></Column>
						<Column><Button text="Customer" icon="{= ${sortModel>/customerName} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/customerName} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="customerName"/><core:CustomData key="tableName" value="idScrapGpTable"/></customData></Button></Column>
						<Column><Button text="Vehicle No" icon="{= ${sortModel>/vehicleNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/vehicleNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="vehicleNo"/><core:CustomData key="tableName" value="idScrapGpTable"/></customData></Button></Column>
						<Column hAlign="Center"><Text text="Action" class="gpmsTableHeaderText"/></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRowPress" class="gpmsTableRow">
							<cells>
								<Text text="{scrapGpList>gatePassNo}" class="gpmsTableText"/>
								<Text text="{scrapGpList>requestId}" class="gpmsTableText"/>
								<Text text="{scrapGpList>requestDateStr}" class="gpmsTableText"/>
								<VBox>
									<Text text="{scrapGpList>customerName}" class="gpmsTableText"/>
									<Text text="{scrapGpList>customerGst}" class="gpmsLabel" wrapping="false"/>
								</VBox>
								<Text text="{scrapGpList>vehicleNo}" class="gpmsTableText"/>
								<Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onRowPress" tooltip="View Gate Pass"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>
