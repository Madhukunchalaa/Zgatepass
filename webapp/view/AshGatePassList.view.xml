<mvc:View
	controllerName="zgpms.meilpower.com.controller.AshGatePassList"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page
		title="Ash Gate Pass List"
		showNavButton="true"
		navButtonPress=".onNavBack"
		class="gpmsPage">
		<content>
			<VBox class="sapUiSmallMargin">
				<Table
					id="ashListTable"
					items="{ashList>/results}"
					noDataText="No Ash Gate Passes found"
					class="gpmsTable"
					alternateRowColors="true">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Ash Gate Passes" level="H2"/>
							<ToolbarSpacer/>
							<SearchField width="300px" search=".onSearch" placeholder="Search Gate Pass No..." class="gpmsFieldInput"/>
							<DatePicker id="idExcelFromDate" placeholder="From Date" displayFormat="dd-MM-yyyy" width="150px" change=".onDateFilterChange"/>
							<DatePicker id="idExcelToDate" placeholder="To Date" displayFormat="dd-MM-yyyy" width="150px" change=".onDateFilterChange"/>
							<Button icon="sap-icon://download" text="Download Excel" press=".onDownloadExcel" tooltip="Export to Excel"/>
							<Button icon="sap-icon://sort" tooltip="Sort" press=".onSort" type="Transparent"/>
							<Button id="idAshCopyListBtn" icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard"/>
							<Button id="idAshPrintListBtn" icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print list"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column><Button text="Gate Pass No" icon="{= ${sortModel>/GatePassNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatePassNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatePassNo"/><core:CustomData key="tableName" value="ashListTable"/></customData></Button></Column>
						<Column><Button text="Sales Document" icon="{= ${sortModel>/SalesDocument} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/SalesDocument} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="SalesDocument"/><core:CustomData key="tableName" value="ashListTable"/></customData></Button></Column>
						<Column><Button text="Customer Name" icon="{= ${sortModel>/CustomerName} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/CustomerName} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="CustomerName"/><core:CustomData key="tableName" value="ashListTable"/></customData></Button></Column>
						<Column><Button text="Vehicle No" icon="{= ${sortModel>/VehicleNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/VehicleNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="VehicleNo"/><core:CustomData key="tableName" value="ashListTable"/></customData></Button></Column>
						<Column><Button text="GP Date" icon="{= ${sortModel>/GPDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GPDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GPDate"/><core:CustomData key="tableName" value="ashListTable"/></customData></Button></Column>
						<Column hAlign="Center" width="4rem"><Text text="Action" class="gpmsTableHeaderText"/></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRowPress" class="gpmsTableRow">
							<cells>
								<Text text="{ashList>GatePassNo}" class="gpmsTableText"/>
								<Text text="{ashList>SalesDocument}" class="gpmsTableText"/>
								<Text text="{ashList>CustomerName}" class="gpmsTableText"/>
								<Text text="{ashList>VehicleNo}" class="gpmsTableText"/>
								<Text text="{path: 'ashList>GPDate', formatter: '.formatDate'}" class="gpmsTableText"/>
								<Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onRowPress" tooltip="Open Details"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>
