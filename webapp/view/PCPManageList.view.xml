<mvc:View
    controllerName="zgpms.meilpower.com.controller.PCPManageList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    height="100%">

    <Page title="PCPs" class="gpmsPage" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiSmallMargin">
                <Table id="idPCPTable"
                    items="{pcpManageList>/results}"
                    class="gpmsTable"
                    noDataText="No PCP records found."
                    alternateRowColors="true"
                    growing="true"
                    growingThreshold="50">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="PCPs" level="H2"/>
                            <ToolbarSpacer/>
                            <SearchField id="idPCPSearch" width="220px" search=".onSearch" placeholder="Search..." class="gpmsFieldInput"/>
                            <Button text="Add PCP" icon="sap-icon://add" type="Emphasized" press=".onCreateNew"/>
                            <Select id="idPCPStatusFilter" change=".onApplyFilters" width="150px" class="gpmsFieldInput">
                                <items>
                                    <core:Item key="" text="All Statuses"/>
                                    <core:Item key="Closed" text="Closed"/>
                                    <core:Item key="Pending" text="Pending"/>
                                </items>
                            </Select>
                            <DatePicker id="idExcelFromDate" placeholder="From Date" displayFormat="dd-MMM-yyyy" width="150px" class="gpmsFieldInput"/>
                            <DatePicker id="idExcelToDate" placeholder="To Date" displayFormat="dd-MMM-yyyy" width="150px" class="gpmsFieldInput"/>
                            <Button text="Apply" type="Emphasized" press=".onApplyFilters"/>
                            <Button text="Clear" press=".onClearFilters"/>
                            <Button icon="sap-icon://download" text="Download Excel" press=".onDownloadExcel" tooltip="Export to Excel" class="sapUiTinyMarginEnd"/>
                            <Button icon="sap-icon://sort" tooltip="Sort" press=".onSort" type="Transparent" class="sapUiTinyMarginEnd"/>
                            <Button icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard" class="sapUiTinyMarginEnd"/>
                            <Button icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print list"/>
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="9rem"><Button text="Gate Pass No" icon="{= ${sortModel>/GatepassNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatepassNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatepassNo"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column width="9rem"><Button text="PCP No" icon="{= ${sortModel>/PCPNO} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/PCPNO} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="PCPNO"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column width="8rem"><Button text="PCP Date" icon="{= ${sortModel>/PCPDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/PCPDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="PCPDate"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column width="7rem"><Button text="Entry" icon="{= ${sortModel>/Status} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/Status} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="Status"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column width="6rem"><Button text="GE No" icon="{= ${sortModel>/GateEntryNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GateEntryNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GateEntryNo"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column width="8rem"><Button text="GE Date" icon="{= ${sortModel>/GEDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GEDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GEDate"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Button text="Supplier" icon="{= ${sortModel>/VendorDesc} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/VendorDesc} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="VendorDesc"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Button text="Items" icon="{= ${sortModel>/OpenItems} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/OpenItems} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="OpenItems"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><Button text="DC/INV No" icon="{= ${sortModel>/DCNumber} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/DCNumber} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="DCNumber"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column width="7rem"><Button text="Status" icon="{= ${sortModel>/OverallStatus} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/OverallStatus} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="OverallStatus"/><core:CustomData key="tableName" value="idPCPManageListTable"/></customData></Button></Column>
                        <Column width="9rem" hAlign="Center"><Text text="Action" class="gpmsTableHeaderText"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem class="gpmsTableRow">
                            <cells>
                                <Text text="{pcpManageList>GatepassNo}" class="gpmsTableText sapMObjectIdentifierTitle"/>
                                <Text text="{pcpManageList>PCPNO}" class="gpmsTableText"/>
                                <Text text="{pcpManageList>PCPDate}" class="gpmsTableText"/>
                                <Text text="{pcpManageList>EntryPoint}" class="gpmsTableText"/>
                                <Text text="{pcpManageList>GateEntryNo}" class="gpmsTableText"/>
                                <Text text="{pcpManageList>GEDate}" class="gpmsTableText"/>
                                <Text text="{pcpManageList>VendorDesc}" class="gpmsTableText"/>
                                <Text text="{pcpManageList>FirstItemDesc}" class="gpmsTableText"/>
                                <Text text="{pcpManageList>DCNumber}" class="gpmsTableText"/>
                                <ObjectStatus
                                    text="{= ${pcpManageList>GatepassNo} ? 'Closed' : 'Pending'}"
                                    state="{= ${pcpManageList>GatepassNo} ? 'Success' : 'Warning'}"/>
                                <HBox justifyContent="Center" class="gpmsActionBox">
                                    <Button icon="sap-icon://show"  type="Transparent" tooltip="View"  press=".onViewRow"  class="sapUiTinyMarginEnd gpmsActionButton"/>
                                    <Button icon="sap-icon://edit"  type="Transparent" tooltip="Edit"  press=".onEditRow"  class="sapUiTinyMarginEnd gpmsActionButton"/>
                                    <Button icon="sap-icon://print" type="Transparent" tooltip="Print" press=".onPrintRow" class="gpmsActionButton"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
            </VBox>
        </content>
    </Page>

</mvc:View>
