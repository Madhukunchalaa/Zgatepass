<mvc:View
	controllerName="zgpms.meilpower.com.controller.PCPList"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page title="Gate Entry List" class="gpmsPage" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<VBox class="sapUiSmallMargin">
				<!-- Date Range Filter Bar -->
			<HBox alignItems="End" class="sapUiSmallMarginBottom" wrap="Wrap">
				<VBox class="sapUiSmallMarginEnd">
					<Label text="From Date" class="gpmsFieldLabel"/>
					<DatePicker id="idFilterFromDate" displayFormat="dd-MM-yyyy" placeholder="From Date" width="180px" class="gpmsFieldInput"/>
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text="To Date" class="gpmsFieldLabel"/>
					<DatePicker id="idFilterToDate" displayFormat="dd-MM-yyyy" placeholder="To Date" width="180px" class="gpmsFieldInput"/>
				</VBox>
				<Button text="Apply" type="Emphasized" press=".onDateFilter" class="sapUiSmallMarginEnd"/>
				<Button text="Clear" type="Transparent" press=".onClearDateFilter"/>
			</HBox>

			<Table id="pcpTable" items="{pcpList>/results}" class="gpmsTable" noDataText="No Gate Entries Found" alternateRowColors="true" growing="true" growingThreshold="20" growingScrollToLoad="true">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Gate Entry List" level="H2"/>
							<ToolbarSpacer />
							<SearchField width="220px" search=".onSearch" placeholder="Search..." class="gpmsFieldInput"/>
							<Select id="idInspectionStatusFilter" width="150px" change=".onStatusFilterChange" class="gpmsFieldInput">
								<items>
									<core:Item key="" text="All Statuses"/>
									<core:Item key="Open" text="Open"/>
									<core:Item key="Pending" text="Pending"/>
									<core:Item key="Completed" text="Completed"/>
								</items>
							</Select>
							<Button icon="sap-icon://sort" tooltip="Sort" press=".onSort" type="Transparent"/>
							<Button icon="sap-icon://filter" tooltip="Filter" press=".onFilter" type="Transparent"/>
							<Button text="Create Entry" icon="sap-icon://add" type="Emphasized" press=".onAddPCP" />
							<Button icon="sap-icon://download" text="Download Excel" press=".onDownloadExcel" tooltip="Export to Excel" class="sapUiTinyMarginEnd"/>
							<Button icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard" class="sapUiTinyMarginEnd"/>
							<Button icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print list"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column><Button text="GE Date" icon="{= ${sortModel>/GEDate} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GEDate} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GEDate"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="GE No" icon="{= ${sortModel>/GateEntryNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GateEntryNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GateEntryNo"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="Supplier" icon="{= ${sortModel>/VendorDesc} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/VendorDesc} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="VendorDesc"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="Source Type" icon="{= ${sortModel>/SourceType} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/SourceType} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="SourceType"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="Dept" icon="{= ${sortModel>/Department} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/Department} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="Department"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="RGP No" icon="{= ${sortModel>/RGPNumber} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/RGPNumber} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="RGPNumber"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="Inv No" icon="{= ${sortModel>/DCNumber} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/DCNumber} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="DCNumber"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="RR No" icon="{= ${sortModel>/RRNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/RRNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="RRNo"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="Gate Pass No" icon="{= ${sortModel>/GatepassNo} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/GatepassNo} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="GatepassNo"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column><Button text="Inspection Status" icon="{= ${sortModel>/InspectionStatus} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/InspectionStatus} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="InspectionStatus"/><core:CustomData key="tableName" value="idPCPListTable"/></customData></Button></Column>
						<Column hAlign="Center"><Text text="Action" class="gpmsTableHeaderText"/></Column>
					</columns>
					<items>
						<ColumnListItem class="gpmsTableRow">
							<cells>
								<Text text="{pcpList>GEDate}" class="gpmsTableText"/>
								<Text text="{pcpList>GateEntryNo}" class="gpmsTableText"/>
								<Text text="{pcpList>VendorDesc}" class="gpmsTableText"/>
								<Text text="{pcpList>SourceType}" class="gpmsTableText"/>
								<Text text="{pcpList>Department}" class="gpmsTableText"/>
								<Text text="{pcpList>RGPNumber}" class="gpmsTableText"/>
								<Text text="{pcpList>DCNumber}" class="gpmsTableText"/>
								<Text text="{pcpList>RRNo}" class="gpmsTableText"/>
								<Text text="{pcpList>GatepassNo}" class="gpmsTableText"/>
								<Text text="{pcpList>InspectionStatus}" class="gpmsTableText"/>
								<HBox justifyContent="Center" class="gpmsActionBox">
									<Button icon="sap-icon://show" type="Default" tooltip="View" press=".onViewPCP" class="sapUiTinyMarginEnd gpmsActionButton"/>
									<Button icon="sap-icon://edit" type="Default" tooltip="Edit" press=".onEditPCP" class="sapUiTinyMarginEnd gpmsActionButton"/>
								</HBox>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>
