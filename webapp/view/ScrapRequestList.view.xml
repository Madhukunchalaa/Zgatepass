<mvc:View
	controllerName="zgpms.meilpower.com.controller.ScrapRequestList"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page
		title="Scrap Request List"
		showNavButton="true"
		navButtonPress=".onNavBack"
		class="gpmsPage">
		<content>
			<VBox class="sapUiSmallMargin">
				<Table
					id="scrapRequestTable"
					items="{scrapList>/}"
					noDataText="No Scrap Requests found"
					class="gpmsTable"
					alternateRowColors="true">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Scrap Requests" level="H2"/>
							<ToolbarSpacer/>
							<SearchField width="300px" search=".onSearch" placeholder="Search Request No..." class="gpmsFieldInput"/>
							<DatePicker id="idExcelFromDate" placeholder="From Date" displayFormat="dd-MMM-yyyy" width="150px" change=".onDateFilterChange"/>
							<DatePicker id="idExcelToDate" placeholder="To Date" displayFormat="dd-MMM-yyyy" width="150px" change=".onDateFilterChange"/>
							<Button icon="sap-icon://download" text="Download Excel" press=".onDownloadExcel" tooltip="Export to Excel"/>
							<Button icon="sap-icon://sort" tooltip="Sort" press=".onSort" type="Transparent"/>
							<Button id="idScrapReqCopyListBtn" icon="sap-icon://copy" text="Copy" press=".onCopyList" tooltip="Copy list to clipboard"/>
							<Button id="idScrapReqPrintListBtn" icon="sap-icon://print" text="Print List" press=".onPrintList" tooltip="Print list"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column><Button text="Request No" icon="{= ${sortModel>/requestId} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/requestId} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="requestId"/><core:CustomData key="tableName" value="idScrapTable"/></customData></Button></Column>
						<Column><Button text="Date" icon="{= ${sortModel>/requestDateStr} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/requestDateStr} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="requestDateStr"/><core:CustomData key="tableName" value="idScrapTable"/></customData></Button></Column>
						<Column><Button text="Vehicle No" icon="{= ${sortModel>/vehicleDetails} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/vehicleDetails} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="vehicleDetails"/><core:CustomData key="tableName" value="idScrapTable"/></customData></Button></Column>
						<Column><Button text="Status" icon="{= ${sortModel>/status} === 'Asc' ? 'sap-icon://sort-ascending' : ${sortModel>/status} === 'Desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort' }" press=".onColumnHeaderSort" type="Transparent" class="gpmsTableHeaderBtn"><customData><core:CustomData key="sortKey" value="status"/><core:CustomData key="tableName" value="idScrapTable"/></customData></Button></Column>
						<Column hAlign="Center"><Text text="Action" class="gpmsTableHeaderText"/></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRowPress" class="gpmsTableRow">
							<cells>
								<Text text="{scrapList>requestId}" class="gpmsTableText"/>
								<Text text="{scrapList>requestDateStr}" class="gpmsTableText"/>
								<Text text="{scrapList>vehicleDetails}" class="gpmsTableText"/>
								<ObjectStatus text="{scrapList>status}" state="{= ${scrapList>status} === 'Approved' ? 'Success' : (${scrapList>status} === 'Rejected' || ${scrapList>status} === 'AM' || ${scrapList>status} === 'AMENDMENT' ? 'Error' : 'Warning') }"/>
								<Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onRowPress" tooltip="Open Request"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>
